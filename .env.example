# Secrets for lighthouse.yaml. Copy to .env and fill in; .env is never committed.
# Real environment variables win over this file.

# auth: one token per person (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
PP_TOKEN_ALICE=
PP_TOKEN_BOB=

# forge
GITHUB_TOKEN=
# GITLAB_TOKEN=

# notify
SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SMTP_USER=
# SMTP_PASSWORD=

# model providers (only the ones in llm.providers)
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# MISTRAL_API_KEY=

# Time the model gets to review one update's source diff. The demo default (60 s)
# suits the small demo libraries; real releases (log4j 2.14.1 -> 2.17.1 changes 125
# files) need minutes with a hosted model. Too little time never lets an update
# through: it is marked `unreviewed` and waits for a human.
# VET_BUDGET_SECONDS=600

# Mirror credentials, if registries.headers in lighthouse.yaml references them
# REGISTRY_TOKEN=

# a single token, recorded as "operator"; scripts/reset_demo.sh sends it
# PP_API_TOKEN=
