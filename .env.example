# Secrets for patchpilot.yaml. Copy to .env and fill in; .env is never committed.
# Real environment variables win over this file.

# auth: one token per person (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
PP_TOKEN_ALICE=
PP_TOKEN_BOB=

# forge
GITHUB_TOKEN=
# GITLAB_TOKEN=

# notify
SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SMTP_USER=
# SMTP_PASSWORD=

# model providers (only the ones in llm.providers)
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# MISTRAL_API_KEY=

# scripts/reset_demo.sh sends this token when auth is on
# PP_API_TOKEN=
